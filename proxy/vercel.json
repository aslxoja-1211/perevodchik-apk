{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-App-Client" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/privacy" },
    { "source": "/privacy", "destination": "/api/privacy" },
    { "source": "/privacy-policy", "destination": "/api/privacy" }
  ]
}
